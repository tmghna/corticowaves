digraph CorticoWavesFlowchart {
    graph [
        rankdir=TB,
        splines=ortho,
        nodesep=0.55,
        ranksep=0.75,
        fontname="Helvetica",
        fontsize=12,
        bgcolor="#FAFAFA"
    ];

    node [
        fontname="Helvetica",
        fontsize=10,
        shape=rect,
        style="filled,rounded",
        fillcolor="#FFFFFF",
        color="#333333",
        penwidth=1.2,
        margin="0.2,0.1"
    ];

    edge [
        fontname="Helvetica",
        fontsize=9,
        color="#444444",
        penwidth=1.2
    ];

    subgraph cluster_acquisition {
        label="STAGE 1: Hardware Acquisition";
        style="filled,rounded";
        fillcolor="#E8F0FE";
        color="#1A73E8";
        fontname="Helvetica-Bold";
        fontsize=11;

        eeg [label="BioAmp EXG Pill\nEEG analog signal", fillcolor="#D2E3FC"];
        arduino [label="Arduino Uno\nNative ADC @ 100 Hz\nStandardFirmata over USB"];
        ads1115 [label="ADS1115\n16-bit ADC over I2C"];
        esp32 [label="ESP32\n250 SPS compact CSV over USB"];

        eeg -> arduino [xlabel=" Analog output"];
        eeg -> ads1115 [xlabel=" Analog output to A0"];
        ads1115 -> esp32 [xlabel=" I2C\nSDA/SCL"];
    }

    subgraph cluster_dsp {
        label="STAGE 2: Python Acquisition and DSP";
        style="filled,rounded";
        fillcolor="#E6F4EA";
        color="#137333";
        fontname="Helvetica-Bold";
        fontsize=11;

        input [label="Shared acquisition adapter\nVoltage samples + source metadata"];
        filter [label="Streaming Butterworth band-pass\nArduino: 0.5-30 Hz\nESP32: 0.5-50 Hz"];
        buffer [label="Sliding signal buffer\n1.5 s Welch window"];
        psd [label="Welch PSD\nAlpha: 8-12 Hz\nBeta: 13-30 Hz", fillcolor="#CEEAD6"];
        ratio [label="Beta / Alpha attention ratio\n0.4 s ratio smoothing"];
        adaptive [label="Adaptive online normalization\n5 s warm-up\n30 s EWMA mean/variance"];
        metric [label="Sigmoid attention metric\nz_score + running statistics\nattention_metric in [0, 1]"];

        input -> filter -> buffer -> psd -> ratio -> adaptive -> metric;
    }

    subgraph cluster_transport {
        label="STAGE 3: Local Telemetry";
        style="filled,rounded";
        fillcolor="#FEF7E0";
        color="#B06000";
        fontname="Helvetica-Bold";
        fontsize=11;

        publisher [label="Acquisition publisher\nLatest-value packets up to 20 Hz"];
        relay [label="telemetry_bridge.py\nWebSocket relay\nws://localhost:8765", fillcolor="#FFE082"];

        publisher -> relay [xlabel=" JSON telemetry packets"];
    }

    subgraph cluster_dashboard {
        label="STAGE 4: Astro Dashboard";
        style="filled,rounded";
        fillcolor="#F3E8FD";
        color="#7627BB";
        fontname="Helvetica-Bold";
        fontsize=11;

        telemetry [label="Live Neural Telemetry\nSignal-strength graph\nAttention metric readout"];
        game [label="Navigation Engine\nAttention-controlled rocket game\nStart / pause / restart controls", fillcolor="#E9D5FF"];

        telemetry -> game [xlabel=" attention_metric"];
    }

    arduino -> input [xlabel=" Firmata samples"];
    esp32 -> input [xlabel=" CSV serial samples"];
    metric -> publisher [xlabel=" Derived metric + DSP metadata"];
    relay -> telemetry [xlabel=" WebSocket stream"];
}
