---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#080a0a" />
    <title>CorticoWaves // Neural Telemetry</title>
  </head>
  <body class="font-mono text-zinc-200">
    <main class="mx-auto min-h-screen max-w-[1600px] px-4 py-5 sm:px-8 lg:px-10">
      <header class="mb-5 flex flex-wrap items-end justify-between gap-4 border-b border-toxic/40 pb-4">
        <div>
          <p class="mb-2 text-[10px] tracking-[0.35em] text-toxic/70">CW // CORTICOTHALAMIC CONTROL SYSTEM</p>
          <h1 class="glow-text text-2xl font-bold tracking-[0.12em] text-toxic sm:text-4xl">CORTICOWAVES</h1>
        </div>
        <div class="text-right text-[10px] uppercase tracking-[0.2em] text-zinc-500">
          <p>Pipeline: <span class="text-amber">STAGE_02 / DSP</span></p>
          <p>Transport: <span id="connection-state" class="text-zinc-400">OFFLINE</span></p>
        </div>
      </header>

      <section class="grid auto-rows-min gap-5 lg:grid-cols-[minmax(0,1.35fr)_minmax(320px,0.65fr)]">
        <article class="panel-grid flex min-h-[480px] flex-col border border-toxic/70 bg-black/60 shadow-[0_0_28px_rgba(183,255,60,0.08)]">
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-toxic/40 px-4 py-3">
            <div>
              <h2 class="text-sm font-bold tracking-[0.16em] text-toxic">01 // LIVE NEURAL TELEMETRY</h2>
              <p class="mt-1 text-[9px] uppercase tracking-[0.16em] text-zinc-600">Signal amplitude // rolling 5 second window // high resolution</p>
            </div>
            <div class="flex items-center gap-4">
              <div class="attention-readout">
                <span class="attention-label">ATTENTION METRIC</span>
                <strong id="attention-value">--.--</strong>
              </div>
              <span class="flex items-center gap-2 text-[10px] text-zinc-500"><i id="status-led" class="h-2 w-2 rounded-full bg-zinc-700"></i>WS : 8765</span>
            </div>
          </div>
          <div class="signal-chart-wrap">
            <canvas id="signal-chart" aria-label="Live signal strength over time"></canvas>
            <div class="chart-axis-y"><span id="chart-max">1.00</span><span id="chart-mid">0.50</span><span id="chart-min">0.00</span></div>
            <span class="chart-axis-label">SIGNAL STRENGTH</span>
            <span class="chart-time-label">TIME // LIVE</span>
          </div>
          <div id="telemetry-feed" class="telemetry-scroll max-h-28 overflow-y-auto border-t border-toxic/20 px-4 py-2 text-[10px] leading-5 text-zinc-400" aria-live="polite">
            <p class="text-zinc-600">[ boot ] awaiting neural stream on ws://localhost:8765</p>
          </div>
          <div class="border-t border-toxic/20 px-4 py-3 text-[10px] uppercase tracking-[0.16em] text-zinc-600">
            Live amplitude trace // raw packets and derived attention metric
          </div>
        </article>

        <div class="grid gap-5">
          <article class="flex min-h-[230px] flex-col border border-dashed border-amber/70 bg-black/50 shadow-[0_0_24px_rgba(255,176,0,0.07)]">
            <div class="border-b border-amber/30 px-4 py-3">
              <h2 class="text-sm font-bold tracking-[0.16em] text-amber">02 // NAVIGATION ENGINE</h2>
            </div>
            <div id="rocket-game-container" class="flex flex-1 items-center justify-center p-6 text-center text-xs tracking-[0.12em] text-amber/70">
              [ AWAITING NEURAL ROCKET ENGINE INTEGRATION ]
            </div>
          </article>

          <article class="flex min-h-[230px] flex-col border border-dashed border-toxic/50 bg-black/50 shadow-[0_0_24px_rgba(183,255,60,0.07)]">
            <div class="border-b border-toxic/30 px-4 py-3">
              <h2 class="text-sm font-bold tracking-[0.16em] text-toxic">03 // CORTICAL STATE HEATMAP</h2>
            </div>
            <div id="neural-field-container" class="flex flex-1 items-center justify-center p-6 text-center text-xs tracking-[0.12em] text-toxic/60">
              [ AWAITING WEBGL WILSON-COWAN SIMULATION ]
            </div>
          </article>
        </div>
      </section>
    </main>

    <script>
      const feed = document.querySelector('#telemetry-feed');
      const state = document.querySelector('#connection-state');
      const led = document.querySelector('#status-led');
      const canvas = document.querySelector('#signal-chart');
      const chartContext = canvas?.getContext('2d');
      const attentionValue = document.querySelector('#attention-value');
      const chartMax = document.querySelector('#chart-max');
      const chartMid = document.querySelector('#chart-mid');
      const chartMin = document.querySelector('#chart-min');
      const endpoint = 'ws://localhost:8765';
      const signalHistory = [];
      const windowSeconds = 5;
      const maxSamples = 1000;
      const maxFeedLines = 120;
      let socket;
      let retryTimer;
      let hasReportedConnectionWarning = false;
      let drawPending = false;

      const scheduleDraw = () => {
        if (drawPending) return;
        drawPending = true;
        window.requestAnimationFrame(() => {
          drawPending = false;
          drawChart();
        });
      };

      const resizeChart = () => {
        if (!canvas || !chartContext) return;
        const bounds = canvas.getBoundingClientRect();
        const pixelRatio = window.devicePixelRatio || 1;
        canvas.width = Math.max(1, Math.floor(bounds.width * pixelRatio));
        canvas.height = Math.max(1, Math.floor(bounds.height * pixelRatio));
        chartContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        drawChart();
      };

      const drawChart = () => {
        if (!canvas || !chartContext) return;
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        const padding = { top: 24, right: 18, bottom: 26, left: 18 };
        const plotWidth = width - padding.left - padding.right;
        const plotHeight = height - padding.top - padding.bottom;
        const now = signalHistory.length ? signalHistory[signalHistory.length - 1].time : Date.now() / 1000;
        const visibleSamples = signalHistory.filter((sample) => now - sample.time <= windowSeconds);
        const values = visibleSamples.length ? visibleSamples.map((sample) => sample.value) : [0];
        const dataMin = Math.min(...values);
        const dataMax = Math.max(...values);
        const range = Math.max(dataMax - dataMin, Math.abs(dataMax) * 0.08, 0.001);
        const min = dataMin - range * 0.15;
        const max = dataMax + range * 0.15;
        const toX = (time) => padding.left + ((time - (now - windowSeconds)) / windowSeconds) * plotWidth;
        const toY = (value) => padding.top + (1 - (value - min) / (max - min)) * plotHeight;

        chartContext.clearRect(0, 0, width, height);
        chartContext.fillStyle = '#080a0a';
        chartContext.fillRect(0, 0, width, height);

        chartContext.lineWidth = 1;
        chartContext.strokeStyle = 'rgba(183, 255, 60, 0.11)';
        for (let row = 0; row <= 4; row += 1) {
          const y = padding.top + (row / 4) * plotHeight;
          chartContext.beginPath();
          chartContext.moveTo(padding.left, y);
          chartContext.lineTo(width - padding.right, y);
          chartContext.stroke();
        }
        for (let column = 0; column <= 6; column += 1) {
          const x = padding.left + (column / 6) * plotWidth;
          chartContext.beginPath();
          chartContext.moveTo(x, padding.top);
          chartContext.lineTo(x, height - padding.bottom);
          chartContext.stroke();
        }

        if (!visibleSamples.length) return;
        chartContext.beginPath();
        visibleSamples.forEach((sample, index) => {
          const x = toX(sample.time);
          const y = toY(sample.value);
          if (index === 0) chartContext.moveTo(x, y);
          else chartContext.lineTo(x, y);
        });
        chartContext.lineWidth = 1;
        chartContext.strokeStyle = '#b7ff3c';
        chartContext.shadowColor = 'rgba(183, 255, 60, 0.9)';
        chartContext.shadowBlur = 3;
        chartContext.stroke();
        chartContext.shadowBlur = 0;

        const latest = visibleSamples[visibleSamples.length - 1];
        const latestX = toX(latest.time);
        const latestY = toY(latest.value);
        chartContext.beginPath();
        chartContext.arc(latestX, latestY, 3, 0, Math.PI * 2);
        chartContext.fillStyle = '#ffb000';
        chartContext.shadowColor = '#ffb000';
        chartContext.shadowBlur = 12;
        chartContext.fill();
        chartContext.shadowBlur = 0;

        if (chartMax) chartMax.textContent = max.toFixed(2);
        if (chartMid) chartMid.textContent = ((max + min) / 2).toFixed(2);
        if (chartMin) chartMin.textContent = min.toFixed(2);
      };

      window.addEventListener('resize', resizeChart);
      resizeChart();

      const appendLine = (text, className = 'text-zinc-400') => {
        const line = document.createElement('p');
        line.className = className;
        line.textContent = text;
        feed?.appendChild(line);
        if (feed) {
          while (feed.childElementCount > maxFeedLines) feed.firstElementChild?.remove();
          feed.scrollTop = feed.scrollHeight;
        }
      };

      const formatPacket = (payload) => {
        if (typeof payload !== 'object' || payload === null) return [`raw: ${String(payload)}`];
        const raw = payload.raw ?? payload.voltage ?? payload.sample ?? 'n/a';
        const attention = payload.attention ?? payload.attention_metric ?? payload.metric ?? 'n/a';
        const numericRaw = Number(raw);
        const numericAttention = Number(attention);
        if (Number.isFinite(numericRaw)) {
          const packetTime = Number(payload.timestamp);
          signalHistory.push({
            value: numericRaw,
            time: Number.isFinite(packetTime) ? packetTime : Date.now() / 1000
          });
          if (signalHistory.length > maxSamples) signalHistory.shift();
          scheduleDraw();
        }
        if (Number.isFinite(numericAttention)) {
          if (attentionValue) attentionValue.textContent = numericAttention.toFixed(2);
        }
        const source = payload.source ?? 'unknown';
        const filter = payload.filtered ? `filter: ${payload.bandpass ?? 'enabled'}` : 'filter: none';
        const averaging = payload.display_averaged ? `display_avg: ${payload.samples_averaged ?? '?'} samples` : 'display_avg: none';
        return [`raw: ${JSON.stringify(raw)}`, `attention_metric: ${attention}`, `source: ${source}`, filter, averaging];
      };

      const connect = () => {
        socket = new WebSocket(endpoint);
        socket.addEventListener('open', () => {
          hasReportedConnectionWarning = false;
          if (state) state.textContent = 'CONNECTED';
          state?.classList.replace('text-zinc-400', 'text-toxic');
          led?.classList.replace('bg-zinc-700', 'bg-toxic');
          appendLine('[ link ] websocket connected', 'text-toxic');
        });
        socket.addEventListener('message', (event) => {
          let payload = event.data;
          try { payload = JSON.parse(event.data); } catch { /* display non-JSON streams as raw text */ }
          const packetLines = formatPacket(payload);
          // Keep the diagnostic feed readable at high sample rates; every
          // packet still reaches the chart at its native timestamp.
          if (typeof payload !== 'object' || payload.sample_index === undefined || payload.sample_index % 10 === 0) {
            packetLines.forEach((line) => appendLine(`[ data ] ${line}`));
          }
        });
        socket.addEventListener('close', () => {
          if (state) state.textContent = 'OFFLINE';
          state?.classList.replace('text-toxic', 'text-zinc-400');
          led?.classList.replace('bg-toxic', 'bg-zinc-700');
          if (!hasReportedConnectionWarning) {
            appendLine('[ link ] telemetry bridge offline; retrying in 3s', 'text-amber');
            hasReportedConnectionWarning = true;
          }
          retryTimer = window.setTimeout(connect, 3000);
        });
        socket.addEventListener('error', () => {
          if (!hasReportedConnectionWarning) {
            appendLine('[ warn ] unable to reach telemetry bridge', 'text-amber');
            hasReportedConnectionWarning = true;
          }
        });
      };

      connect();
    </script>
  </body>
</html>
