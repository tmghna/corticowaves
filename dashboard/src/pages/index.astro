---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#080a0a" />
    <title>CorticoWaves // Neural Telemetry</title>
  </head>
  <body class="font-mono text-zinc-200">
    <main class="dashboard-shell mx-auto max-w-[1900px] px-5 py-5 sm:px-8 lg:px-10">
      <header class="dashboard-header flex flex-wrap items-end justify-between gap-4 border-b border-toxic/40 pb-4">
        <div>
          <p class="mb-2 text-[10px] tracking-[0.35em] text-toxic/75 sm:text-xs">CW // CORTICOTHALAMIC CONTROL SYSTEM</p>
          <h1 class="glow-text text-3xl font-bold tracking-[0.12em] text-toxic sm:text-4xl">CORTICOWAVES</h1>
        </div>
        <div class="text-right text-xs uppercase tracking-[0.2em] text-sky-200/60">
          <p>Pipeline: <span class="text-amber">STAGE_02 / DSP</span></p>
          <p>Transport: <span id="connection-state" class="text-zinc-400">OFFLINE</span></p>
        </div>
      </header>

      <section class="dashboard-grid grid gap-4 lg:grid-cols-[minmax(0,1.65fr)_minmax(360px,0.8fr)]">
        <article class="panel-grid flex min-h-0 flex-col border border-dashed border-amber/70 bg-black/60 shadow-[0_0_28px_rgba(255,176,0,0.1)]">
          <div class="flex items-center justify-between border-b border-amber/40 px-4 py-3">
            <div>
              <h2 class="text-base font-bold tracking-[0.16em] text-amber sm:text-lg">02 // NAVIGATION ENGINE</h2>
              <p class="mt-2 text-[11px] uppercase tracking-[0.16em] text-sky-200/55">Neural altitude control // sigmoid-mapped attention</p>
            </div>
            <span id="rocket-control-state" class="text-xs uppercase tracking-[0.16em] text-sky-200/55">NO SIGNAL</span>
          </div>
          <div id="rocket-game-container" class="rocket-game-surface">
            <canvas id="rocket-game-canvas" aria-label="Attention-controlled neural rocket game"></canvas>
            <div id="rocket-game-controls" class="rocket-game-controls">
              <button id="rocket-start-button" type="button">START MISSION</button>
              <button id="rocket-restart-button" type="button" hidden>RESTART MISSION</button>
            </div>
          </div>
          <div class="border-t border-amber/20 px-5 py-4 text-xs uppercase tracking-[0.16em] text-sky-200/50">
            Z-score + sigmoid control // smooth target tracking // press R to relaunch
          </div>
        </article>

        <article class="panel-grid telemetry-panel flex min-h-0 flex-col border border-toxic/70 bg-black/60 shadow-[0_0_28px_rgba(183,255,60,0.08)]">
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-toxic/40 px-4 py-3">
            <div>
              <h2 class="text-base font-bold tracking-[0.16em] text-toxic sm:text-lg">01 // LIVE NEURAL TELEMETRY</h2>
              <p class="mt-2 text-[11px] uppercase tracking-[0.16em] text-sky-200/55">Signal amplitude // rolling 5 second window // high resolution</p>
            </div>
            <div class="flex items-center gap-4">
              <div class="attention-readout">
                <span class="attention-label">ATTENTION METRIC</span>
                <strong id="attention-value">--.--</strong>
              </div>
              <span class="flex items-center gap-2 text-xs text-sky-200/60"><i id="status-led" class="h-2 w-2 rounded-full bg-slate-600"></i>WS : 8765</span>
            </div>
          </div>
          <div class="signal-chart-wrap">
            <canvas id="signal-chart" aria-label="Live signal strength over time"></canvas>
            <div class="chart-axis-y"><span id="chart-max">1.00</span><span id="chart-mid">0.50</span><span id="chart-min">0.00</span></div>
            <span class="chart-axis-label">SIGNAL STRENGTH</span>
            <span class="chart-time-label">TIME // LIVE</span>
          </div>
          <div id="telemetry-feed" class="telemetry-scroll max-h-36 overflow-y-auto border-t border-toxic/20 px-5 py-3 text-xs leading-6 text-sky-100/70" aria-live="polite">
            <p class="text-zinc-600">[ boot ] awaiting neural stream on ws://localhost:8765</p>
          </div>
          <div class="border-t border-toxic/20 px-5 py-3 text-xs uppercase tracking-[0.16em] text-sky-200/50">
            Live amplitude trace // raw packets and derived attention metric
          </div>
        </article>
      </section>
    </main>

    <script>
      const feed = document.querySelector('#telemetry-feed');
      const state = document.querySelector('#connection-state');
      const led = document.querySelector('#status-led');
      const canvas = document.querySelector('#signal-chart');
      const chartContext = canvas?.getContext('2d');
      const attentionValue = document.querySelector('#attention-value');
      const chartMax = document.querySelector('#chart-max');
      const chartMid = document.querySelector('#chart-mid');
      const chartMin = document.querySelector('#chart-min');
      const endpoint = 'ws://localhost:8765';
      const signalHistory = [];
      const windowSeconds = 5;
      const maxSamples = 1000;
      const maxFeedLines = 120;
      const rocketCanvas = document.querySelector('#rocket-game-canvas');
      const rocketContext = rocketCanvas?.getContext('2d');
      const rocketState = document.querySelector('#rocket-control-state');
      const startButton = document.querySelector('#rocket-start-button');
      const restartButton = document.querySelector('#rocket-restart-button');
      const rocket = {
        y: 0,
        targetY: 0,
        score: 0,
        highScore: 0,
        started: false,
        gameOver: false,
        planets: [],
        previousLane: Math.random() > 0.5 ? 'upper' : 'lower',
        nextPlanetX: 1.1,
        typeIndex: 0,
        typeSequence: [],
        stars: Array.from({ length: 90 }, () => ({ x: Math.random(), y: Math.random(), speed: 0.02 + Math.random() * 0.08, size: 1 + Math.random() * 2 }))
      };
      const planetTypes = [
        { name: 'Venus', radius: 0.073, color: '#dc964b' },
        { name: 'Mercury', radius: 0.067, color: '#a5a5ae' },
        { name: 'Jupiter', radius: 0.09, color: '#c39164' },
        { name: 'Saturn', radius: 0.078, color: '#69b9cd' },
        { name: 'Earth', radius: 0.071, color: '#2364d7' },
        { name: 'Neptune', radius: 0.08, color: '#2d78fa' }
      ];
      const planetByName = Object.fromEntries(planetTypes.map((planet) => [planet.name, planet]));
      const makePlanetSequence = (length = 60, previous = null) => {
        const sequence = [];
        let last = previous;
        while (sequence.length < length) {
          const block = [...planetTypes].sort(() => Math.random() - 0.5);
          if (last && block[0].name === last) continue;
          sequence.push(...block.map((planet) => planet.name));
          last = block[block.length - 1].name;
        }
        return sequence.slice(0, length);
      };
      let latestAttentionTime = 0;
      let rocketLastFrame = performance.now();
      let smoothedAttention = 0.5;

      const updateRocketAttention = (attention) => {
        if (!Number.isFinite(attention) || attention < 0 || attention > 1) return;
        const now = performance.now();
        const elapsed = latestAttentionTime ? Math.max(0, (now - latestAttentionTime) / 1000) : 0.1;
        const smoothing = 1 - Math.exp(-elapsed / 0.55);
        smoothedAttention += (attention - smoothedAttention) * smoothing;
        const normalized = smoothedAttention;
        latestAttentionTime = now;
        if (rocketCanvas) {
          const top = 45;
          const bottom = Math.max(top + 1, rocketCanvas.clientHeight - 45);
          rocket.targetY = bottom - normalized * (bottom - top);
        }
        if (rocketState) {
          rocketState.textContent = `DRIVE ${Math.round(normalized * 100)}%`;
          rocketState.className = 'text-[10px] uppercase tracking-[0.16em] text-amber';
        }
      };

      const resetRocketGame = () => {
        rocket.score = 0;
        rocket.gameOver = false;
        rocket.y = rocketCanvas ? rocketCanvas.clientHeight / 2 : 0;
        rocket.targetY = rocket.y;
        rocket.planets = [];
        rocket.previousLane = Math.random() > 0.5 ? 'upper' : 'lower';
        rocket.nextPlanetX = 1.1;
        rocket.typeIndex = 0;
        rocket.typeSequence = makePlanetSequence();
        while (rocket.nextPlanetX < 2.5) spawnPlanet();
      };

      const choosePlanetY = (planet, lane, x) => {
        if (!rocketCanvas) return lane === 'upper' ? 0.3 : 0.7;
        const height = rocketCanvas.clientHeight;
        const radius = planet.radius * height;
        const top = 45;
        const bottom = height - 45;
        const low = lane === 'upper' ? top + radius + 12 : height * 0.56 + radius;
        const high = lane === 'upper' ? height * 0.44 - radius : bottom - radius - 12;
        if (high <= low) return (low + high) / 2 / height;
        for (let attempt = 0; attempt < 100; attempt += 1) {
          const candidate = low + Math.random() * (high - low);
          const valid = rocket.planets.every((existing) => {
            const dx = (x - existing.x) * rocketCanvas.clientWidth;
            const dy = candidate - existing.y * height;
            return Math.hypot(dx, dy) >= radius + existing.radius * height + 12;
          });
          if (valid) return candidate / height;
        }
        return (low + high) / 2 / height;
      };

      const spawnPlanet = () => {
        if (!rocketCanvas) return;
        if (rocket.typeIndex >= rocket.typeSequence.length) {
          rocket.typeSequence = makePlanetSequence(60, rocket.typeSequence.at(-1));
          rocket.typeIndex = 0;
        }
        const planet = planetByName[rocket.typeSequence[rocket.typeIndex]];
        rocket.typeIndex += 1;
        const lane = Math.random() > 0.5 ? 'upper' : 'lower';
        const gapTime = lane === rocket.previousLane ? 1.0 : 2.5;
        const x = rocket.nextPlanetX;
        rocket.planets.push({
          name: planet.name,
          x,
          y: choosePlanetY(planet, lane, x),
          radius: planet.radius,
          hue: planet.color,
          lane,
          passed: false
        });
        rocket.nextPlanetX += 0.25 * gapTime;
        rocket.previousLane = lane;
      };

      const resizeRocketCanvas = () => {
        if (!rocketCanvas || !rocketContext) return;
        const bounds = rocketCanvas.getBoundingClientRect();
        const ratio = window.devicePixelRatio || 1;
        rocketCanvas.width = Math.max(1, Math.floor(bounds.width * ratio));
        rocketCanvas.height = Math.max(1, Math.floor(bounds.height * ratio));
        rocketContext.setTransform(ratio, 0, 0, ratio, 0, 0);
        if (!rocket.y) resetRocketGame();
      };

      const drawRocket = (ctx, x, y, angle) => {
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(angle);
        ctx.shadowColor = '#36e1ff';
        ctx.shadowBlur = 14;
        ctx.fillStyle = '#14558f';
        ctx.strokeStyle = '#37e1ff';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(38, 0);
        ctx.lineTo(10, -15);
        ctx.lineTo(-27, -11);
        ctx.lineTo(-38, 0);
        ctx.lineTo(-27, 11);
        ctx.lineTo(10, 15);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.fillStyle = '#c8f8ff';
        ctx.beginPath();
        ctx.arc(6, 0, 8, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#28618a';
        ctx.beginPath();
        ctx.arc(7, 0, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffb000';
        ctx.beginPath();
        ctx.moveTo(-28, -7);
        ctx.lineTo(-52 - Math.random() * 8, 0);
        ctx.lineTo(-28, 7);
        ctx.fill();
        ctx.restore();
      };

      const drawRocketGame = (now) => {
        if (!rocketCanvas || !rocketContext) return;
        const width = rocketCanvas.clientWidth;
        const height = rocketCanvas.clientHeight;
        const dt = Math.min((now - rocketLastFrame) / 1000, 0.05);
        rocketLastFrame = now;
        rocketContext.clearRect(0, 0, width, height);
        rocketContext.fillStyle = '#030519';
        rocketContext.fillRect(0, 0, width, height);
        const gradient = rocketContext.createRadialGradient(width * 0.48, height * 0.45, 10, width * 0.48, height * 0.45, width * 0.8);
        gradient.addColorStop(0, 'rgba(31, 54, 130, 0.25)');
        gradient.addColorStop(1, 'rgba(3, 5, 25, 0)');
        rocketContext.fillStyle = gradient;
        rocketContext.fillRect(0, 0, width, height);

        rocket.stars.forEach((star) => {
          star.x -= star.speed * dt;
          if (star.x < 0) star.x = 1;
          rocketContext.fillStyle = 'rgba(170, 215, 255, 0.75)';
          rocketContext.fillRect(star.x * width, star.y * height, star.size, star.size);
        });

        if (rocket.started && !rocket.gameOver) {
          if (latestAttentionTime && now - latestAttentionTime > 2500 && rocketCanvas) {
            rocket.targetY += (rocketCanvas.clientHeight / 2 - rocket.targetY) * Math.min(1, dt * 2);
            if (rocketState) {
              rocketState.textContent = 'STALE // NEUTRAL';
              rocketState.className = 'text-[10px] uppercase tracking-[0.16em] text-zinc-600';
            }
          }
          rocket.y += (rocket.targetY - rocket.y) * Math.min(1, dt * 5);
          rocket.nextPlanetX -= dt * 0.16;
          rocket.planets.forEach((planet) => {
            planet.x -= dt * 0.16;
            if (planet.x < -0.15) {
              planet.remove = true;
            }
            if (!planet.passed && planet.x + planet.radius < 0.22) {
              planet.passed = true;
              rocket.score += 1;
            }
          });
          rocket.planets = rocket.planets.filter((planet) => !planet.remove);
          while (rocket.nextPlanetX < 1.35) spawnPlanet();
          const rocketX = width * 0.22;
          rocket.planets.forEach((planet) => {
            const px = planet.x * width;
            const py = planet.y * height;
            if (Math.hypot(px - rocketX, py - rocket.y) < planet.radius * height + 22) {
              rocket.gameOver = true;
              rocket.highScore = Math.max(rocket.highScore, rocket.score);
              if (restartButton) restartButton.hidden = false;
            }
          });
        }

        rocket.planets.forEach((planet) => {
          const px = planet.x * width;
          const py = planet.y * height;
          const radius = planet.radius * height;
          rocketContext.shadowColor = planet.hue;
          rocketContext.shadowBlur = 18;
          rocketContext.fillStyle = planet.hue;
          rocketContext.beginPath();
          rocketContext.arc(px, py, radius, 0, Math.PI * 2);
          rocketContext.fill();
          rocketContext.shadowBlur = 0;
          rocketContext.strokeStyle = 'rgba(220,245,255,0.65)';
          rocketContext.lineWidth = 2;
          rocketContext.stroke();
        });

        const angle = Math.max(-0.3, Math.min(0.3, (rocket.targetY - rocket.y) * 0.004));
        drawRocket(rocketContext, width * 0.22, rocket.y, angle);
        rocketContext.fillStyle = '#f5faff';
        rocketContext.font = '600 15px "IBM Plex Mono", monospace';
        rocketContext.fillText(`SCORE  ${String(rocket.score).padStart(3, '0')}`, 20, 34);
        rocketContext.fillStyle = 'rgba(170,215,255,0.75)';
        rocketContext.font = '600 15px "IBM Plex Mono", monospace';
        rocketContext.fillText(`BEST   ${String(rocket.highScore).padStart(3, '0')}`, 20, 58);
        rocketContext.fillStyle = 'rgba(170,215,255,0.72)';
        rocketContext.font = '11px "IBM Plex Mono", monospace';
        rocketContext.fillText('ATTENTION // Z-SCORE + SIGMOID ALTITUDE CONTROL', 18, height - 17);
        if (rocket.gameOver) {
          rocketContext.fillStyle = 'rgba(3,5,25,0.72)';
          rocketContext.fillRect(0, 0, width, height);
          rocketContext.fillStyle = '#f5faff';
          rocketContext.font = '700 28px "IBM Plex Mono", monospace';
          rocketContext.textAlign = 'center';
          rocketContext.fillText('GAME OVER', width / 2, height / 2 - 10);
          rocketContext.font = '13px "IBM Plex Mono", monospace';
          rocketContext.fillText('USE RESTART MISSION TO RELAUNCH', width / 2, height / 2 + 22);
          rocketContext.textAlign = 'left';
        }
        if (!rocket.started) {
          rocketContext.fillStyle = 'rgba(3,5,25,0.35)';
          rocketContext.fillRect(0, 0, width, height);
          rocketContext.fillStyle = '#f5faff';
          rocketContext.font = '600 15px "IBM Plex Mono", monospace';
          rocketContext.textAlign = 'center';
          rocketContext.fillText('NEURAL ROCKET ENGINE STANDBY', width / 2, height / 2 + 55);
          rocketContext.textAlign = 'left';
        }
        window.requestAnimationFrame(drawRocketGame);
      };

      window.addEventListener('resize', resizeRocketCanvas);
      const startRocketGame = () => {
        resetRocketGame();
        rocket.started = true;
        if (startButton) startButton.hidden = true;
        if (restartButton) restartButton.hidden = true;
        if (rocketState) rocketState.textContent = 'ARMED // AWAITING SIGNAL';
      };

      startButton?.addEventListener('click', startRocketGame);
      restartButton?.addEventListener('click', startRocketGame);
      resizeRocketCanvas();
      window.requestAnimationFrame(drawRocketGame);
      let socket;
      let retryTimer;
      let hasReportedConnectionWarning = false;
      let drawPending = false;

      const scheduleDraw = () => {
        if (drawPending) return;
        drawPending = true;
        window.requestAnimationFrame(() => {
          drawPending = false;
          drawChart();
        });
      };

      const resizeChart = () => {
        if (!canvas || !chartContext) return;
        const bounds = canvas.getBoundingClientRect();
        const pixelRatio = window.devicePixelRatio || 1;
        canvas.width = Math.max(1, Math.floor(bounds.width * pixelRatio));
        canvas.height = Math.max(1, Math.floor(bounds.height * pixelRatio));
        chartContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        drawChart();
      };

      const drawChart = () => {
        if (!canvas || !chartContext) return;
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        const padding = { top: 24, right: 18, bottom: 26, left: 18 };
        const plotWidth = width - padding.left - padding.right;
        const plotHeight = height - padding.top - padding.bottom;
        const now = signalHistory.length ? signalHistory[signalHistory.length - 1].time : Date.now() / 1000;
        const visibleSamples = signalHistory.filter((sample) => now - sample.time <= windowSeconds);
        const values = visibleSamples.length ? visibleSamples.map((sample) => sample.value) : [0];
        const dataMin = Math.min(...values);
        const dataMax = Math.max(...values);
        const range = Math.max(dataMax - dataMin, Math.abs(dataMax) * 0.08, 0.001);
        const min = dataMin - range * 0.15;
        const max = dataMax + range * 0.15;
        const toX = (time) => padding.left + ((time - (now - windowSeconds)) / windowSeconds) * plotWidth;
        const toY = (value) => padding.top + (1 - (value - min) / (max - min)) * plotHeight;

        chartContext.clearRect(0, 0, width, height);
        chartContext.fillStyle = '#080a0a';
        chartContext.fillRect(0, 0, width, height);

        chartContext.lineWidth = 1;
        chartContext.strokeStyle = 'rgba(183, 255, 60, 0.11)';
        for (let row = 0; row <= 4; row += 1) {
          const y = padding.top + (row / 4) * plotHeight;
          chartContext.beginPath();
          chartContext.moveTo(padding.left, y);
          chartContext.lineTo(width - padding.right, y);
          chartContext.stroke();
        }
        for (let column = 0; column <= 6; column += 1) {
          const x = padding.left + (column / 6) * plotWidth;
          chartContext.beginPath();
          chartContext.moveTo(x, padding.top);
          chartContext.lineTo(x, height - padding.bottom);
          chartContext.stroke();
        }

        if (!visibleSamples.length) return;
        chartContext.beginPath();
        visibleSamples.forEach((sample, index) => {
          const x = toX(sample.time);
          const y = toY(sample.value);
          if (index === 0) chartContext.moveTo(x, y);
          else chartContext.lineTo(x, y);
        });
        chartContext.lineWidth = 1;
        chartContext.strokeStyle = '#b7ff3c';
        chartContext.shadowColor = 'rgba(183, 255, 60, 0.9)';
        chartContext.shadowBlur = 3;
        chartContext.stroke();
        chartContext.shadowBlur = 0;

        const latest = visibleSamples[visibleSamples.length - 1];
        const latestX = toX(latest.time);
        const latestY = toY(latest.value);
        chartContext.beginPath();
        chartContext.arc(latestX, latestY, 3, 0, Math.PI * 2);
        chartContext.fillStyle = '#ffb000';
        chartContext.shadowColor = '#ffb000';
        chartContext.shadowBlur = 12;
        chartContext.fill();
        chartContext.shadowBlur = 0;

        if (chartMax) chartMax.textContent = max.toFixed(2);
        if (chartMid) chartMid.textContent = ((max + min) / 2).toFixed(2);
        if (chartMin) chartMin.textContent = min.toFixed(2);
      };

      window.addEventListener('resize', resizeChart);
      resizeChart();

      const appendLine = (text, className = 'text-zinc-400') => {
        const line = document.createElement('p');
        line.className = className;
        line.textContent = text;
        feed?.appendChild(line);
        if (feed) {
          while (feed.childElementCount > maxFeedLines) feed.firstElementChild?.remove();
          feed.scrollTop = feed.scrollHeight;
        }
      };

      const formatPacket = (payload) => {
        if (typeof payload !== 'object' || payload === null) return [`raw: ${String(payload)}`];
        const raw = payload.raw ?? payload.voltage ?? payload.sample ?? 'n/a';
        const attention = payload.attention_metric ?? payload.attention ?? payload.metric ?? 'n/a';
        const numericRaw = Number(raw);
        const numericAttention = Number(attention);
        if (Number.isFinite(numericRaw)) {
          const packetTime = Number(payload.timestamp);
          signalHistory.push({
            value: numericRaw,
            time: Number.isFinite(packetTime) ? packetTime : Date.now() / 1000
          });
          if (signalHistory.length > maxSamples) signalHistory.shift();
          scheduleDraw();
        }
        if (Number.isFinite(numericAttention)) {
          if (attentionValue) attentionValue.textContent = numericAttention.toFixed(2);
          updateRocketAttention(numericAttention);
        }
        const source = payload.source ?? 'unknown';
        const filter = payload.filtered ? `filter: ${payload.bandpass ?? 'enabled'}` : 'filter: none';
        const averaging = payload.display_averaged ? `display_avg: ${payload.samples_averaged ?? '?'} samples` : 'display_avg: none';
        return [`raw: ${JSON.stringify(raw)}`, `attention_metric: ${attention}`, `source: ${source}`, filter, averaging];
      };

      const connect = () => {
        socket = new WebSocket(endpoint);
        socket.addEventListener('open', () => {
          hasReportedConnectionWarning = false;
          if (state) state.textContent = 'CONNECTED';
          state?.classList.replace('text-zinc-400', 'text-toxic');
          led?.classList.replace('bg-zinc-700', 'bg-toxic');
          appendLine('[ link ] websocket connected', 'text-toxic');
        });
        socket.addEventListener('message', (event) => {
          let payload = event.data;
          try { payload = JSON.parse(event.data); } catch { /* display non-JSON streams as raw text */ }
          const packetLines = formatPacket(payload);
          // Keep the diagnostic feed readable at high sample rates; every
          // packet still reaches the chart at its native timestamp.
          if (typeof payload !== 'object' || payload.sample_index === undefined || payload.sample_index % 10 === 0) {
            packetLines.forEach((line) => appendLine(`[ data ] ${line}`));
          }
        });
        socket.addEventListener('close', () => {
          if (state) state.textContent = 'OFFLINE';
          state?.classList.replace('text-toxic', 'text-zinc-400');
          led?.classList.replace('bg-toxic', 'bg-zinc-700');
          if (!hasReportedConnectionWarning) {
            appendLine('[ link ] telemetry bridge offline; retrying in 3s', 'text-amber');
            hasReportedConnectionWarning = true;
          }
          retryTimer = window.setTimeout(connect, 3000);
        });
        socket.addEventListener('error', () => {
          if (!hasReportedConnectionWarning) {
            appendLine('[ warn ] unable to reach telemetry bridge', 'text-amber');
            hasReportedConnectionWarning = true;
          }
        });
      };

      connect();
    </script>
  </body>
</html>
